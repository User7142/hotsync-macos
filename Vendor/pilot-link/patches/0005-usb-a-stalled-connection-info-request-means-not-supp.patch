From 496732af8dab521dabd6548836ae682fb7c1c62f Mon Sep 17 00:00:00 2001
From: User7142 <5984280+User7142@users.noreply.github.com>
Date: Wed, 7 Oct 2026 10:00:06 +0200
Subject: [PATCH] usb: a stalled connection-info request means "not supported"

USB_configure_generic gives up on a device whenever
PALM_GET_EXT_CONNECTION_INFORMATION fails (6f98960d, for a Tungsten X
that had to be skipped until the right interface showed up). A device
that does not implement the request at all answers with a stall
(-EPIPE) on every try, so it is skipped forever: a Sony CLIE N770C
(0x054c:0x0066, one bulk endpoint pair 0x82/0x02) never synced, and the
CLIE said its serial port was in use by another application.

Treat a stall as "not supported": go on without pipe numbers and let
USB_poll take the bulk endpoints, as it does for the CLIE 3.5 and
USB_INIT_NONE devices and as the Linux visor driver does for these
CLIEs. Other errors - a timeout while a device is still switching to
HotSync - still skip the device until it answers.
---
 libpisock/usb.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/libpisock/usb.c b/libpisock/usb.c
index 594906cc..ae7dfe45 100644
--- a/libpisock/usb.c
+++ b/libpisock/usb.c
@@ -1069,6 +1069,16 @@ USB_configure_generic (pi_usb_data_t *dev, u_int8_t *input_pipe, u_int8_t *outpu
 		}
 	}
 
+	if (ret == -EPIPE) {
+		/* The device stalls the request: it does not implement it (a
+		 * Sony CLIE N770C, 0x054c:0x0066, does). That is no failure -
+		 * go on without pipe numbers and let the caller take the bulk
+		 * endpoints, as for the CLIE 3.5 and USB_INIT_NONE devices.
+		 * Other errors (a timeout while a device is still switching to
+		 * HotSync) skip the device until it answers. */
+		LOG((PI_DBG_DEV, PI_DBG_LVL_INFO, "usb: PALM_GET_EXT_CONNECTION_INFORMATION not supported, using the bulk endpoints\n"));
+		return 0;
+	}
 	if (ret < 0) {
 		LOG((PI_DBG_DEV, PI_DBG_LVL_ERR, "usb: PALM_GET_EXT_CONNECTION_INFORMATION failed (err=%08x)\n", ret));
 	} else {
